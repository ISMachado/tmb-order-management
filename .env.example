# ============================================================================
# Copie este arquivo para ".env" (cp .env.example .env) e ajuste os valores.
# O arquivo ".env" NUNCA deve ser commitado (ja esta no .gitignore).
# Os valores abaixo sao apenas para desenvolvimento local.
# ============================================================================

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_DB=orders
POSTGRES_USER=orders
POSTGRES_PASSWORD=change-me-orders-db

# Usuario SOMENTE LEITURA usado pelo modulo de IA (so enxerga as views analiticas).
ORDERS_READONLY_USER=orders_readonly
ORDERS_READONLY_PASSWORD=change-me-readonly

# --- RabbitMQ ---------------------------------------------------------------
RABBITMQ_USER=orders
RABBITMQ_PASSWORD=change-me-rabbit

# --- pgAdmin (interface de administracao do banco) --------------------------
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change-me-pgadmin

# --- Modulo de IA "Pergunte sobre os Pedidos" (opcional) --------------------
# Sem a chave, o modulo fica desativado e o resto do sistema funciona normalmente.
# Crie a chave em https://console.anthropic.com -> API Keys.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# --- Comportamento ----------------------------------------------------------
# true = cria ~60 pedidos de demonstracao na primeira subida (util para testar a IA).
SEED_DEMO_DATA=true
# Tempo entre "Processando" e "Finalizado" (o desafio pede 5 segundos).
PROCESSING_DELAY_SECONDS=5

# --- Portas expostas no seu computador --------------------------------------
FRONTEND_PORT=3000
API_PORT=5080
PGADMIN_PORT=5050
RABBITMQ_MANAGEMENT_PORT=15672
JAEGER_PORT=16686
POSTGRES_PORT=5432
