<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- CA1848/CA1873: LoggerMessage source generators seriam excesso para este escopo.
         CA2007: ConfigureAwait desnecessario em ASP.NET Core / worker services.
         CA1062: nullable reference types ja cobrem validacao de argumentos.
         CA1515: tipos publicos sao necessarios para testes e para o WebApplicationFactory. -->
    <NoWarn>$(NoWarn);CA1848;CA1873;CA2007;CA1062;CA1515;CA1711;CA1716;CA1031;CA1724</NoWarn>
  </PropertyGroup>
</Project>
